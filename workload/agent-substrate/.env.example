# Copy this file to .env and fill in your GCP project and GKE cluster values:
#   cp .env.example .env
PROJECT_ID="YOUR_PROJECT_ID"
PROJECT_NUMBER="YOUR_PROJECT_NUMBER"
GOOGLE_CLOUD_PROJECT="YOUR_PROJECT_ID"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI="true"

GCE_REGION="us-central1"
CLUSTER_LOCATION="us-central1"
CLUSTER_NAME="cluster-std"

NODE_GSA_NAME="minimal-node"
SNAPSHOT_TRANSFER_GSA_NAME="ate-snapshot-transfer"

# Pattern 3 (ADK Agent ActorTemplate) Cloud Build artifact
ADK_AGENT_IMAGE_REPO="us-central1-docker.pkg.dev/YOUR_PROJECT_ID/apps/adk-actor-agent"
ADK_AGENT_IMAGE_DIGEST="sha256:YOUR_IMAGE_SHA256_DIGEST"
ADK_AGENT_IMAGE="us-central1-docker.pkg.dev/YOUR_PROJECT_ID/apps/adk-actor-agent@sha256:YOUR_IMAGE_SHA256_DIGEST"
